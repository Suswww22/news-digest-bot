# 複製成 .env 後填入（.env 已在 .gitignore，不會被提交）
# 擇一即可：只填 GEMINI_API_KEY 時會自動使用 Gemini
# Gemini 免費金鑰：https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# 選填：claude 或 gemini，強制指定使用哪一家
LLM_PROVIDER=
# 選填：預設 gemini-flash-latest / claude-opus-5-5
GEMINI_MODEL=
CLAUDE_MODEL=
# Discord：頻道設定 → 整合 → Webhook → 複製網址
DISCORD_WEBHOOK_URL=
# LINE Messaging API（LINE Notify 已於 2025/3 停止服務）
LINE_CHANNEL_ACCESS_TOKEN=
# 填入 user/group ID 則用 push，留空則 broadcast 給所有好友
LINE_TO=
